OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_API_KEY=
OPENAI_EXTRA_BODY={}
CONTEXT_WINDOW_TOKENS=32768
MAX_OUTPUT_TOKENS=1024
TOKEN_SAFETY_MARGIN=316
REQUEST_TIMEOUT_SECONDS=60
STORE_NAME=本店
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=xiaolin_ch02
DB_NAME_TEST=xiaolin_ch02_test
TOOL_TIMEOUT_SECONDS=5
TOOL_MAX_ATTEMPTS=2

# ch03 knowledge base
# 也可填 BAAI/bge-m3 由 sentence-transformers 自动下载（需能访问 HuggingFace）
EMBEDDING_MODEL=.cache/models/bge-m3
EMBEDDING_DEVICE=cuda
EMBEDDING_BATCH_SIZE=16
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=knowledge
KNOWLEDGE_DOC_DIR=examples/knowledge
KNOWLEDGE_TOP_K=10
KNOWLEDGE_CANDIDATES=50
KNOWLEDGE_RRF_K=60

# ch04 hybrid retrieval / rerank / generation control
KNOWLEDGE_RERANK_MODEL=.cache/models/bge-reranker-v2-m3
KNOWLEDGE_RERANK_DEVICE=cuda
KNOWLEDGE_RERANK_BATCH_SIZE=8
KNOWLEDGE_RERANK_MIN_SCORE=0.30
KNOWLEDGE_QUERY_REWRITE=true
KNOWLEDGE_SELF_CHECK=true
KNOWLEDGE_TOOL_TIMEOUT_SECONDS=20
KNOWLEDGE_STRATEGY=hybrid_rerank
KNOWLEDGE_MINING_ENABLED=false
KNOWLEDGE_MINING_INTERVAL_MINUTES=60
KNOWLEDGE_MINING_LOOKBACK_DAYS=7
KNOWLEDGE_DEDUPE_THRESHOLD=0.95

# ch05 workflow / agent
WORKFLOW_CHECKPOINT_PATH=.cache/langgraph/ch05.sqlite
WORKFLOW_AGENT_MAX_STEPS=4
WORKFLOW_AGENT_TOKEN_BUDGET=6000

# ch06 router: coref / intent / expansion
WORKFLOW_INTENT_TIMEOUT_SECONDS=10
WORKFLOW_INTENT_MIN_CONFIDENCE=0.6
WORKFLOW_UNDERSTANDING_ENABLED=true
WORKFLOW_UNDERSTANDING_TIMEOUT_SECONDS=10
WORKFLOW_QUERY_EXPANSION=true
WORKFLOW_QUERY_EXPANSION_MAX=3

# ch07 context: three layers / async summary / budget / logs
# 预算 = 窗口 − 输出 − 余量 − 系统(实测 1234) − 证据(400×RERANK_TOP_K) − 梗概 − ReAct 峰值(步数×工具结果)
# 历史预算取「HISTORY_KEEP_ROUNDS×HISTORY_ROUND_TOKENS」与「窗口匀得出的」较小者，再按 7:3 分层
MAX_USER_INPUT_TOKENS=2000
TOOL_RESULT_MAX_TOKENS=1200
HISTORY_KEEP_ROUNDS=20
HISTORY_ROUND_TOKENS=600
CONTEXT_SUMMARY_ENABLED=true
SUMMARY_TIMEOUT_SECONDS=20
# 每轮 model_ctx / history_ctx 与摘要级联都写这里；填 :memory: 可关闭落盘
LOG_FILE=log/app.log
