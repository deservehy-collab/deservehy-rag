OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_API_KEY=
OPENAI_EXTRA_BODY={}
CONTEXT_WINDOW_TOKENS=8192
MAX_OUTPUT_TOKENS=1024
TOKEN_SAFETY_MARGIN=512
REQUEST_TIMEOUT_SECONDS=60
STORE_NAME=本店
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=xiaolin_ch02
DB_NAME_TEST=xiaolin_ch02_test
TOOL_TIMEOUT_SECONDS=5
TOOL_MAX_ATTEMPTS=2

# ch03 knowledge base
# 也可填 BAAI/bge-m3 由 sentence-transformers 自动下载（需能访问 HuggingFace）
EMBEDDING_MODEL=.cache/models/bge-m3
EMBEDDING_DEVICE=cuda
EMBEDDING_BATCH_SIZE=16
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=knowledge
KNOWLEDGE_DOC_DIR=examples/knowledge
KNOWLEDGE_TOP_K=10
KNOWLEDGE_CANDIDATES=50
KNOWLEDGE_RRF_K=60

# ch04 hybrid retrieval / rerank / generation control
KNOWLEDGE_RERANK_MODEL=.cache/models/bge-reranker-v2-m3
KNOWLEDGE_RERANK_DEVICE=cuda
KNOWLEDGE_RERANK_BATCH_SIZE=8
KNOWLEDGE_RERANK_MIN_SCORE=0.30
KNOWLEDGE_QUERY_REWRITE=true
KNOWLEDGE_SELF_CHECK=true
KNOWLEDGE_TOOL_TIMEOUT_SECONDS=20
KNOWLEDGE_STRATEGY=hybrid_rerank
KNOWLEDGE_MINING_ENABLED=false
KNOWLEDGE_MINING_INTERVAL_MINUTES=60
KNOWLEDGE_MINING_LOOKBACK_DAYS=7
KNOWLEDGE_DEDUPE_THRESHOLD=0.95
